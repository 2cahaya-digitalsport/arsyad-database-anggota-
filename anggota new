        // Dropdown Otomatis Ranting / Rayon dari Database Firebase
        async function muatDropdownRayonPendaftaran() {
            const select = document.getElementById("reg-rayon");
            if (!select) return;
            const currentVal = select.value;

            try {
                const [snapRayon, snapAnggota] = await Promise.all([
                    database.ref("administrasi_digital/rayon").once("value"),
                    database.ref("administrasi_digital/anggota").once("value")
                ]);

                const setRayon = new Set();
                const valRayon = snapRayon.val();
                if (valRayon) {
                    Object.values(valRayon).forEach(r => {
                        if (r && r.nama_rayon_ranting) {
                            setRayon.add(String(r.nama_rayon_ranting).trim());
                        }
                    });
                }
                const valAnggota = snapAnggota.val();
                if (valAnggota) {
                    Object.values(valAnggota).forEach(a => {
                        if (a && a.ranting_rayon) {
                            setRayon.add(String(a.ranting_rayon).trim());
                        }
                    });
                }

                const daftarRayon = Array.from(setRayon).filter(Boolean).sort((a, b) => a.localeCompare(b));

                if (daftarRayon.length === 0) {
                    select.innerHTML = `<option value="">-- Belum ada data Ranting / Rayon --</option>`;
                    return;
                }

                select.innerHTML = `<option value="">-- Pilih Ranting / Rayon --</option>` +
                    daftarRayon.map(r => `<option value="${esc(r)}">${esc(r)}</option>`).join("");

                if (currentVal && daftarRayon.includes(currentVal)) {
                    select.value = currentVal;
                }
            } catch (err) {
                select.innerHTML = `<option value="">-- Gagal memuat Ranting / Rayon --</option>`;
            }
        }

        // Validasi format (JPG, PNG, PDF) & ukuran maksimal 10MB saat memilih file
        function cekFileUploadDaftar(file) {
            if (!file) return { valid: false, msg: "Silakan pilih file foto/dokumen terlebih dahulu." };

            const ext = (file.name.split(".").pop() || "").toLowerCase();
            const allowedExt = ["jpg", "jpeg", "png", "pdf"];
            const allowedMime = ["image/jpeg", "image/png", "application/pdf"];

            const formatValid = allowedMime.includes(file.type) || allowedExt.includes(ext);
            if (!formatValid) {
                return { valid: false, msg: "Format file harus JPG, PNG, atau PDF." };
            }

            if (file.size > MAX_FILE_SIZE_BYTES) {
                const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                return { valid: false, msg: `Ukuran file (${sizeMB} MB) melebihi batas maksimal 10 MB.` };
            }

            return { valid: true, ext: ext, isPdf: file.type === "application/pdf" || ext === "pdf" };
        }

        function validasiPreviewUploadDaftar() {
            const input = document.getElementById("reg-foto");
            const info = document.getElementById("reg-foto-info");
            const errorBox = document.getElementById("daftar-error");
            const errorText = document.getElementById("daftar-error-text");

            errorBox.classList.add("hidden");
            const file = input.files && input.files[0];

            if (!file) {
                info.className = "text-[10px] text-slate-400 mt-1";
                info.innerText = "Format: JPG, PNG, atau PDF. Ukuran maksimal 10 MB.";
                return;
            }

            const cek = cekFileUploadDaftar(file);
            if (!cek.valid) {
                input.value = "";
                info.className = "text-[10px] text-rose-600 font-bold mt-1";
                info.innerText = cek.msg;
                errorText.innerText = cek.msg;
                errorBox.classList.remove("hidden");
                return;
            }

            const sizeLabel = file.size >= 1024 * 1024
                ? `${(file.size / (1024 * 1024)).toFixed(2)} MB`
                : `${Math.round(file.size / 1024)} KB`;

            info.className = "text-[10px] text-emerald-700 font-semibold mt-1";
            info.innerText = `File dipilih: ${file.name} (${sizeLabel})`;
        }

        // Proses baca/konversi file pendaftaran ke Data URL (JPG/PNG dikompres rapi, PDF dibaca utuh)
        function bacaFileDaftar(file, isPdf) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onerror = () => reject(new Error("Gagal membaca file."));
                reader.onload = (e) => {
                    if (isPdf) {
                        resolve(e.target.result);
                        return;
                    }
                    const img = new Image();
                    img.onerror = () => resolve(e.target.result);
                    img.onload = () => {
                        const maxDim = 900;
                        let w = img.width;
                        let h = img.height;
                        if (w > maxDim || h > maxDim) {
                            if (w > h) {
                                h = Math.round((h * maxDim) / w);
                                w = maxDim;
                            } else {
                                w = Math.round((w * maxDim) / h);
                                h = maxDim;
                            }
                        }
                        const canvas = document.createElement("canvas");
                        canvas.width = w;
                        canvas.height = h;
                        const ctx = canvas.getContext("2d");
                        ctx.drawImage(img, 0, 0, w, h);
                        const outputMime = file.type === "image/png" ? "image/png" : "image/jpeg";
                        resolve(canvas.toDataURL(outputMime, 0.8));
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        // Proses Submit Daftar Peserta Baru (Otomatis Tersimpan ke Menu Halaman Persetujuan Admin)
        async function prosesDaftarPeserta(event) {
            event.preventDefault();

            const errorBox = document.getElementById("daftar-error");
            const errorText = document.getElementById("daftar-error-text");
            const successBox = document.getElementById("daftar-success");
            const btn = document.getElementById("btn-daftar");

            errorBox.classList.add("hidden");
            successBox.classList.add("hidden");

            const nama = document.getElementById("reg-nama").value.trim();
            const rayon = document.getElementById("reg-rayon").value.trim();
            const whatsapp = document.getElementById("reg-wa").value.trim();
            const gender = document.getElementById("reg-gender").value;
            const usia = document.getElementById("reg-usia").value;
            const tempatLahir = document.getElementById("reg-tempat-lahir").value.trim();
            const tglLahir = document.getElementById("reg-tgl-lahir").value;
            const username = document.getElementById("reg-user").value.trim();
            const password = document.getElementById("reg-pass").value;
            const fileInput = document.getElementById("reg-foto");
            const file = fileInput.files && fileInput.files[0];

            if (!nama || !rayon || !whatsapp || !gender || !usia || !tempatLahir || !tglLahir || !username || !password) {
                errorText.innerText = "Mohon lengkapi seluruh kolom pendaftaran yang wajib diisi.";
                errorBox.classList.remove("hidden");
                return;
            }

            if (/\s/.test(username)) {
                errorText.innerText = "Username tidak boleh mengandung spasi.";
                errorBox.classList.remove("hidden");
                return;
            }

            const cekFile = cekFileUploadDaftar(file);
            if (!cekFile.valid) {
                errorText.innerText = cekFile.msg;
                errorBox.classList.remove("hidden");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Mengirim Pendaftaran...</span>`;

            try {
                // Cek duplikasi username di anggota aktif, persetujuan admin, & anggota baru
                const [snapAnggota, snapPersetujuan, snapBaru] = await Promise.all([
                    database.ref("administrasi_digital/anggota").once("value"),
                    database.ref("administrasi_digital/persetujuan_admin").once("value"),
                    database.ref("administrasi_digital/anggota_baru").once("value")
                ]);

                const listAnggota = snapAnggota.val() ? Object.values(snapAnggota.val()) : [];
                const listPersetujuan = snapPersetujuan.val() ? Object.values(snapPersetujuan.val()) : [];
                const listBaru = snapBaru.val() ? Object.values(snapBaru.val()) : [];
                const userLower = username.toLowerCase();

                const sudahAdaAktif = listAnggota.some(a =>
                    ((a.username || a.user || "").trim().toLowerCase() === userLower) &&
                    ((a.status || "").toLowerCase() !== "ditolak")
                );
                const sudahAdaPersetujuan = listPersetujuan.some(p =>
                    ((p.username || p.user || "").trim().toLowerCase() === userLower) &&
                    ((p.status || "").toLowerCase() !== "ditolak")
                );
                const sudahAdaBaru = listBaru.some(b =>
                    ((b.username || b.user || "").trim().toLowerCase() === userLower) &&
                    ((b.status || "").toLowerCase() !== "ditolak")
                );

                if (sudahAdaAktif || sudahAdaPersetujuan || sudahAdaBaru) {
                    errorText.innerText = "User (username) sudah terdaftar. Silakan gunakan username lain.";
                    errorBox.classList.remove("hidden");
                    return;
                }

                const fotoBase64 = await bacaFileDaftar(file, cekFile.isPdf);
                const id = String(Date.now());

                const payload = {
                    id: id,
                    nama_lengkap: nama,
                    ranting_rayon: rayon,
                    whatsapp: whatsapp,
                    jenis_kelamin: gender,
                    kualifikasi_usia: usia,
                    tempat_lahir: tempatLahir,
                    tanggal_lahir: tglLahir,
                    tempat_tanggal_lahir: `${tempatLahir}, ${tglLahir}`,
                    username: username,
                    user: username,
                    password: password,
                    foto: fotoBase64,
                    foto_nama: file.name,
                    foto_tipe: file.type || cekFile.ext,
                    status: "Menunggu",
                    tanggal_daftar: new Date().toISOString()
                };

                // Otomatis tersimpan ke halaman Persetujuan Admin
                await database.ref("administrasi_digital/persetujuan_admin/" + id).set(payload);

                document.getElementById("form-daftar-peserta").reset();
                document.getElementById("reg-foto-info").className = "text-[10px] text-slate-400 mt-1";
                document.getElementById("reg-foto-info").innerText = "Format: JPG, PNG, atau PDF. Ukuran maksimal 10 MB.";
                muatDropdownRayonPendaftaran();

                successBox.classList.remove("hidden");
                successBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
            } catch (err) {
                errorText.innerText = "Gagal mengirim pendaftaran: " + err.message;
                errorBox.classList.remove("hidden");
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> <span>KIRIM PENDAFTARAN</span>`;
            }
        }

        // Proses Login Anggota Menggunakan User & Password Terdaftar
        async function prosesLoginAnggota(event) {
            event.preventDefault();
            const userInput = document.getElementById("login-user").value.trim();
            const passInput = document.getElementById("login-pass").value;
            const errorBox = document.getElementById("login-error");
            const errorText = document.getElementById("login-error-text");
            const btn = document.getElementById("btn-login");

            errorBox.classList.add("hidden");

            if (!userInput || !passInput) {
                errorText.innerText = "Mohon isi User dan Password Anda.";
                errorBox.classList.remove("hidden");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Memeriksa Akun...</span>`;

            try {
                const [snapAnggota, snapPersetujuan, snapBaru] = await Promise.all([
                    database.ref("administrasi_digital/anggota").once("value"),
                    database.ref("administrasi_digital/persetujuan_admin").once("value"),
                    database.ref("administrasi_digital/anggota_baru").once("value")
                ]);

                const rawAnggota = snapAnggota.val();
                const listAnggota = rawAnggota ? Object.entries(rawAnggota).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                const userLower = userInput.toLowerCase();

                // Cari di daftar anggota terdaftar resmi yang sudah dikonfirmasi
                const ditemukanAktif = listAnggota.find(item => {
                    const userDb = String(item.username || item.user || "").trim().toLowerCase();
                    const passDb = String(item.password || item.sandi || "");
                    const st = String(item.status || "Dikonfirmasi").toLowerCase();
                    return userDb !== "" && userDb === userLower && passDb !== "" && passDb === passInput && st !== "menunggu" && st !== "ditolak";
                });

                if (ditemukanAktif) {
                    anggotaAktif = ditemukanAktif;
                    dataAnggota = listAnggota.filter(a => {
                        const st = String(a.status || "Dikonfirmasi").toLowerCase();
                        return st !== "menunggu" && st !== "ditolak";
                    });
                    sessionStorage.setItem("anggota_id_login", String(ditemukanAktif.id));
                    bukaPortalAnggota();
                    return;
                }

                // Cek di Persetujuan Admin, Anggota Baru, atau Anggota berstatus Menunggu/Ditolak
                const rawPersetujuan = snapPersetujuan.val();
                const listPersetujuan = rawPersetujuan ? Object.values(rawPersetujuan) : [];
                const rawBaru = snapBaru.val();
                const listBaru = rawBaru ? Object.values(rawBaru) : [];

                const gabungAntrean = [...listPersetujuan, ...listBaru, ...listAnggota];
                const ditemukanAntrean = gabungAntrean.find(item => {
                    const userDb = String(item.username || item.user || "").trim().toLowerCase();
                    const passDb = String(item.password || item.sandi || "");
                    return userDb !== "" && userDb === userLower && passDb !== "" && passDb === passInput;
                });

                if (ditemukanAntrean) {
                    const st = String(ditemukanAntrean.status || "Menunggu").toLowerCase();
                    if (st === "ditolak") {
                        errorText.innerText = "Pendaftaran Anda ditolak oleh Admin. Silakan hubungi pengurus.";
                    } else {
                        errorText.innerText = "Akun Anda sudah terdaftar dan masih menunggu persetujuan Admin.";
                    }
                    errorBox.classList.remove("hidden");
                    return;
                }

                errorText.innerText = "User atau password tidak sesuai dengan data anggota terdaftar.";
                errorBox.classList.remove("hidden");
            } catch (err) {
                errorText.innerText = "Gagal terhubung ke server: " + err.message;
                errorBox.classList.remove("hidden");
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-right-to-bracket"></i> <span>MASUK PORTAL ANGGOTA</span>`;
            }
        }

