<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Portal Anggota - Perisai Diri Medan</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Firebase SDK (Compatibility Version) -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>

    <style>
        html, body {
            touch-action: manipulation;
            -webkit-text-size-adjust: 100%;
        }
        body {
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        @media (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }
        .sidebar-link-active {
            background-color: #059669;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
        }
        .table-scroll {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        ::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }

        /* ==================== CETAK PDF RAPI TANPA TERPOTONG ==================== */
        #print-area {
            display: none;
        }
        @page {
            size: A4 portrait;
            margin: 12mm;
        }
        @media print {
            html, body {
                background: #ffffff !important;
                color: #0f172a !important;
                margin: 0 !important;
                padding: 0 !important;
                height: auto !important;
                min-height: 0 !important;
                overflow: visible !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            body > *:not(#print-area) {
                display: none !important;
            }
            #print-area {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .print-header {
                border-bottom: 2px solid #047857;
                padding-bottom: 10px;
                margin-bottom: 12px;
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                gap: 12px;
            }
            .print-info-box {
                background-color: #f8fafc !important;
                border: 1px solid #cbd5e1;
                border-radius: 8px;
                padding: 10px 12px;
                margin-bottom: 12px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                font-size: 9pt;
            }
            .print-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 9pt;
            }
            .print-table thead {
                display: table-header-group;
            }
            .print-table tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }
            .print-table th,
            .print-table td {
                border: 1px solid #94a3b8;
                padding: 7px 9px;
                vertical-align: top;
                word-wrap: break-word;
                overflow-wrap: anywhere;
            }
            .print-table th {
                background-color: #047857 !important;
                color: #ffffff !important;
                font-weight: 700;
                text-transform: uppercase;
                font-size: 8pt;
                letter-spacing: 0.03em;
            }
            .print-table tbody tr:nth-child(even) {
                background-color: #f8fafc !important;
            }
            .print-table tfoot td {
                background-color: #ecfdf5 !important;
                font-weight: 800;
                color: #065f46 !important;
            }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- ==================== HALAMAN LOGIN & DAFTAR PESERTA BARU ==================== -->
    <section id="page-login" class="min-h-[100dvh] w-full overflow-y-auto flex items-center justify-center p-3 sm:p-6 bg-gradient-to-br from-emerald-950 via-emerald-900 to-slate-900">
        <div id="auth-card" class="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden border border-white/10 flex flex-col my-auto transition-all duration-300">
            <!-- Header Card Login -->
            <div class="bg-gradient-to-r from-emerald-700 to-emerald-600 px-5 py-5 sm:py-6 text-center text-white relative shrink-0">
                <div class="w-14 h-14 sm:w-16 sm:h-16 bg-white/15 backdrop-blur-sm rounded-full flex items-center justify-center mx-auto mb-2.5 border-4 border-white/35 shadow-lg">
                    <i class="fa-solid fa-user-shield text-2xl sm:text-3xl text-white"></i>
                </div>
                <h1 class="text-lg sm:text-2xl font-black tracking-tight uppercase leading-tight">
                    Portal Anggota
                </h1>
                <p class="text-[11px] sm:text-xs text-emerald-100 font-semibold uppercase tracking-widest mt-0.5">
                    Perisai Diri Medan
                </p>
            </div>

            <!-- Tab Switcher: Masuk Anggota vs Daftar Peserta Baru -->
            <div class="grid grid-cols-2 bg-slate-100 p-1.5 mx-4 sm:mx-6 mt-4 rounded-2xl border border-slate-200/90">
                <button type="button" id="btn-tab-login" onclick="switchAuthTab('login')"
                    class="py-2.5 rounded-xl text-xs font-bold transition-all bg-white text-emerald-700 shadow-sm cursor-pointer">
                    <i class="fa-solid fa-right-to-bracket mr-1"></i>Masuk Anggota
                </button>
                <button type="button" id="btn-tab-daftar" onclick="switchAuthTab('daftar')"
                    class="py-2.5 rounded-xl text-xs font-bold transition-all text-slate-500 hover:text-slate-800 cursor-pointer">
                    <i class="fa-solid fa-user-plus mr-1"></i>Daftar Peserta Baru
                </button>
            </div>

            <!-- FORM 1: LOGIN ANGGOTA (USER & PASSWORD TERDAFTAR) -->
            <form id="form-login-anggota" onsubmit="prosesLoginAnggota(event)" class="p-4 sm:p-6 space-y-4">
                <div id="login-error" class="hidden bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium px-3.5 py-2.5 rounded-xl flex items-start gap-2">
                    <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm shrink-0 mt-0.5"></i>
                    <span id="login-error-text">User atau password tidak cocok.</span>
                </div>

                <div class="bg-emerald-50/70 border border-emerald-100 rounded-xl px-3.5 py-2.5 text-[11px] text-emerald-800 flex items-center gap-2">
                    <i class="fa-solid fa-circle-info text-emerald-600 shrink-0"></i>
                    <span>Masuk menggunakan <b>User</b> dan <b>Password</b> akun anggota yang telah dikonfirmasi Admin.</span>
                </div>

                <div>
                    <label for="login-user" class="block text-[11px] sm:text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                        User (Username)
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-solid fa-user text-sm"></i>
                        </span>
                        <input type="text" id="login-user" required autocomplete="username"
                            placeholder="Masukkan user terdaftar"
                            class="w-full pl-10 pr-4 py-2.5 sm:py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all">
                    </div>
                </div>

                <div>
                    <label for="login-pass" class="block text-[11px] sm:text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                        Password
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input type="password" id="login-pass" required autocomplete="current-password"
                            placeholder="Masukkan password terdaftar"
                            class="w-full pl-10 pr-11 py-2.5 sm:py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all">
                        <button type="button" onclick="togglePassword('login-pass', 'icon-eye')" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer" aria-label="Tampilkan sandi">
                            <i id="icon-eye" class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" id="btn-login"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold text-xs sm:text-sm py-3 sm:py-3.5 rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>MASUK PORTAL ANGGOTA</span>
                </button>

                <p class="text-[11px] text-center text-slate-500 pt-1">
                    Belum punya akun?
                    <button type="button" onclick="switchAuthTab('daftar')" class="text-emerald-600 font-bold hover:underline cursor-pointer">
                        Daftar Peserta Baru
                    </button>
                </p>
            </form>

            <!-- FORM 2: DAFTAR PESERTA BARU (TERSIMPAN KE PERSETUJUAN ADMIN) -->
            <form id="form-daftar-peserta" onsubmit="prosesDaftarPeserta(event)" class="hidden p-4 sm:p-6 space-y-3 text-xs">
                <div id="daftar-error" class="hidden bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium px-3.5 py-2.5 rounded-xl flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm shrink-0"></i>
                    <span id="daftar-error-text">Terjadi kesalahan pendaftaran.</span>
                </div>

                <div id="daftar-success" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium px-3.5 py-3 rounded-xl flex items-start gap-2.5">
                    <i class="fa-solid fa-circle-check text-emerald-600 text-base shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-bold">Pendaftaran Terkirim!</p>
                        <p id="daftar-success-text" class="text-[11px] text-emerald-700 mt-0.5">Data Anda otomatis masuk ke menu Persetujuan Admin dan menunggu konfirmasi Admin.</p>
                    </div>
                </div>

                <!-- Nama Lengkap -->
                <div>
                    <label for="reg-nama" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                        Nama Lengkap *
                    </label>
                    <input type="text" id="reg-nama" required placeholder="Masukkan nama lengkap"
                        class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500">
                </div>

                <!-- Ranting / Rayon & No. WhatsApp -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="reg-rayon" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                            Ranting / Rayon *
                        </label>
                        <select id="reg-rayon" required
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 font-medium">
                            <option value="">-- Memuat Ranting / Rayon... --</option>
                        </select>
                    </div>

                    <div>
                        <label for="reg-wa" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                            No. WhatsApp *
                        </label>
                        <input type="tel" id="reg-wa" required placeholder="08xxxxxxxxxx"
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500">
                    </div>
                </div>

                <!-- Gender & Kualifikasi Usia -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="reg-gender" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                            Gender *
                        </label>
                        <select id="reg-gender" required
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 font-medium">
                            <option value="">-- Pilih Gender --</option>
                            <option value="Putra">Putra</option>
                            <option value="Putri">Putri</option>
                        </select>
                    </div>

                    <div>
                        <label for="reg-usia" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                            Kualifikasi Usia *
                        </label>
                        <select id="reg-usia" required
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 font-medium">
                            <option value="">-- Pilih Kualifikasi --</option>
                            <option value="Usia Dini 1">Usia Dini 1</option>
                            <option value="Usia Dini 2">Usia Dini 2</option>
                            <option value="Pra Remaja">Pra Remaja</option>
                            <option value="Remaja">Remaja</option>
                            <option value="Dewasa">Dewasa</option>
                        </select>
                    </div>
                </div>

                <!-- Tempat dan Tanggal Lahir -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="reg-tempat-lahir" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                            Tempat Lahir *
                        </label>
                        <input type="text" id="reg-tempat-lahir" required placeholder="Kota / Kabupaten"
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500">
                    </div>

                    <div>
                        <label for="reg-tgl-lahir" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                            Tanggal Lahir *
                        </label>
                        <input type="date" id="reg-tgl-lahir" required
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500">
                    </div>
                </div>

                <!-- User & Password -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="reg-user" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                            User (Username) *
                        </label>
                        <input type="text" id="reg-user" required autocomplete="off" placeholder="Buat username"
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500">
                    </div>

                    <div>
                        <label for="reg-pass" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                            Password *
                        </label>
                        <div class="relative">
                            <input type="password" id="reg-pass" required minlength="4" autocomplete="new-password" placeholder="Buat password"
                                class="w-full pl-3.5 pr-10 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500">
                            <button type="button" onclick="togglePassword('reg-pass', 'icon-eye-reg')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer" aria-label="Tampilkan sandi">
                                <i id="icon-eye-reg" class="fa-solid fa-eye text-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Upload Foto (JPG, PNG, PDF Maksimal 10MB) -->
                <div>
                    <label for="reg-foto" class="block text-[11px] font-bold text-slate-700 uppercase tracking-wide mb-1">
                        Upload Foto (JPG, PNG, PDF Maks. 10MB) *
                    </label>
                    <input type="file" id="reg-foto" required accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf"
                        onchange="validasiPreviewUploadDaftar()"
                        class="w-full text-xs text-slate-600 bg-slate-50 border border-slate-200 rounded-xl p-1.5 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-emerald-600 file:text-white file:text-xs file:font-bold hover:file:bg-emerald-700 cursor-pointer">
                    <p id="reg-foto-info" class="text-[10px] text-slate-400 mt-1">Format: JPG, PNG, atau PDF. Ukuran maksimal 10 MB.</p>
                </div>

                <button type="submit" id="btn-daftar"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold text-xs sm:text-sm py-3 rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span>KIRIM PENDAFTARAN</span>
                </button>

                <p class="text-[11px] text-center text-slate-500">
                    Sudah dikonfirmasi Admin?
                    <button type="button" onclick="switchAuthTab('login')" class="text-emerald-600 font-bold hover:underline cursor-pointer">
                        Masuk di sini
                    </button>
                </p>
            </form>
        </div>
    </section>

    <!-- ==================== HALAMAN PORTAL ANGGOTA DENGAN SIDEBAR ==================== -->
    <section id="page-portal" class="hidden flex-1 flex min-h-screen overflow-x-hidden relative">

        <!-- OVERLAY SIDEBAR (MOBILE) -->
        <div id="sidebar-overlay" onclick="setSidebar(false)" class="fixed inset-0 bg-black/60 backdrop-blur-[1px] z-40 hidden lg:hidden transition-opacity"></div>

        <!-- SIDEBAR NAVIGASI ANGGOTA -->
        <aside id="portal-sidebar"
            class="fixed inset-y-0 left-0 z-50 w-72 shrink-0 bg-slate-900 text-slate-200 flex flex-col justify-between shadow-2xl transition-all duration-300 ease-in-out -translate-x-full lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">
            
            <div class="flex flex-col flex-1 overflow-y-auto">
                <!-- Header Sidebar + Tombol Tutup -->
                <div class="px-4 py-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-9 h-9 rounded-xl bg-emerald-600/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs font-black tracking-wider text-white uppercase truncate">Portal Anggota</p>
                            <p class="text-[10px] text-slate-400 truncate">Perisai Diri Medan</p>
                        </div>
                    </div>
                    <button type="button" onclick="setSidebar(false)" title="Tutup Sidebar"
                        class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Profil Singkat di Sidebar -->
                <div class="p-4 border-b border-slate-800/80 bg-slate-900/50">
                    <div class="flex items-center gap-3">
                        <img id="sidebar-foto" src="https://via.placeholder.com/100" alt="Foto Profil"
                            class="w-11 h-11 rounded-full object-cover border-2 border-emerald-500 bg-white shrink-0">
                        <div class="min-w-0">
                            <p id="sidebar-nama" class="text-xs font-bold text-white truncate">Nama Anggota</p>
                            <p id="sidebar-rayon" class="text-[11px] text-emerald-400 font-medium truncate">Rayon / Ranting</p>
                        </div>
                    </div>
                </div>

                <!-- Menu Sidebar -->
                <nav class="p-3 space-y-1.5 flex-1">
                    <p class="px-3 pt-1 pb-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Menu Informasi</p>

                    <button type="button" onclick="pilihTab('dashboard')" data-tab="dashboard"
                        class="sidebar-btn sidebar-link-active w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-gauge-high w-4 text-center"></i>
                        <span>Dashboard</span>
                    </button>

                    <button type="button" onclick="pilihTab('biodata')" data-tab="biodata"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-id-card w-4 text-center text-emerald-400"></i>
                        <span>Biodata Pribadi</span>
                    </button>

                    <button type="button" onclick="pilihTab('absensi')" data-tab="absensi"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-clipboard-user w-4 text-center text-amber-400"></i>
                        <span>Absensi</span>
                    </button>

                    <button type="button" onclick="pilihTab('riwayat')" data-tab="riwayat"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-receipt w-4 text-center text-sky-400"></i>
                        <span>Riwayat Pembayaran</span>
                    </button>

                    <button type="button" onclick="pilihTab('agenda')" data-tab="agenda"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-calendar-days w-4 text-center text-teal-400"></i>
                        <span>Data Agenda</span>
                    </button>

                    <button type="button" onclick="pilihTab('jadwal')" data-tab="jadwal"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-clock w-4 text-center text-purple-400"></i>
                        <span>Jadwal Latihan</span>
                    </button>

                    <button type="button" onclick="pilihTab('kas')" data-tab="kas"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-wallet w-4 text-center text-emerald-400"></i>
                        <span>Laporan Kas</span>
                    </button>

                    <button type="button" onclick="pilihTab('surat')" data-tab="surat"
