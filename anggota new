        function terapkanStateSidebar() {
            const sidebar = document.getElementById("portal-sidebar");
            const overlay = document.getElementById("sidebar-overlay");
            const isDesktop = window.innerWidth >= 1024;

            if (isDesktop) {
                overlay.classList.add("hidden");
                sidebar.classList.remove("translate-x-0", "-translate-x-full");
                if (sidebarTerbuka) {
                    sidebar.classList.remove("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none");
                    sidebar.classList.add("lg:ml-0", "lg:opacity-100");
                } else {
                    sidebar.classList.remove("lg:ml-0", "lg:opacity-100");
                    sidebar.classList.add("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none");
                }
            } else {
                sidebar.classList.remove("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none", "lg:ml-0", "lg:opacity-100");
                if (sidebarTerbuka) {
                    sidebar.classList.remove("-translate-x-full");
                    sidebar.classList.add("translate-x-0");
                    overlay.classList.remove("hidden");
                } else {
                    sidebar.classList.remove("translate-x-0");
                    sidebar.classList.add("-translate-x-full");
                    overlay.classList.add("hidden");
                }
            }
        }

        window.addEventListener("resize", () => {
            const isDesktopNow = window.innerWidth >= 1024;
            if (isDesktopNow !== lastIsDesktop) {
                lastIsDesktop = isDesktopNow;
                sidebarTerbuka = isDesktopNow;
                terapkanStateSidebar();
            }
        });

        // Helper keamanan HTML & JSON attribute
        function esc(str) {
            if (str === null || str === undefined) return "";
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function safeJsonAttr(val) {
            return JSON.stringify(val || "")
                .replace(/'/g, "\\u0027")
                .replace(/</g, "\\u003c")
                .replace(/>/g, "\\u003e");
        }

        // Normalisasi nama ranting/rayon agar pencocokan konsisten
        function normalisasiNamaRayon(nama) {
            return String(nama || "")
                .trim()
                .toLowerCase()
                .replace(/^(ranting|rayon)\s+/i, "")
                .replace(/\s+/g, " ");
        }

        function cocokNamaRayon(namaA, namaB) {
            const aRaw = String(namaA || "").trim().toLowerCase();
            const bRaw = String(namaB || "").trim().toLowerCase();
            if (!aRaw || !bRaw) return false;
            if (aRaw === bRaw) return true;
            const aNorm = normalisasiNamaRayon(aRaw);
            const bNorm = normalisasiNamaRayon(bRaw);
            return aNorm !== "" && aNorm === bNorm;
        }

        function klasifikasiGender(jk) {
            const val = String(jk || "").trim().toLowerCase();
            if (!val) return "lainnya";
            if (val === "l" || val.includes("putra") || val.includes("laki") || val.includes("pria") || val === "male") {
                return "putra";
            }
            if (val === "p" || val.includes("putri") || val.includes("perempuan") || val.includes("wanita") || val === "female") {
                return "putri";
            }
            return "lainnya";
        }

        function currentMonthISO() {
            const d = new Date();
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, "0");
            return `${y}-${m}`;
        }

        function formatBulanTahun(ymStr) {
            if (!ymStr || !ymStr.includes("-")) return "-";
            const [y, m] = ymStr.split("-").map(Number);
            const d = new Date(y, m - 1, 1);
            if (isNaN(d.getTime())) return ymStr;
            return d.toLocaleDateString("id-ID", { month: "long", year: "numeric" });
        }

        function formatTanggal(tglStr) {
            if (!tglStr || tglStr === "-") return "-";
            const date = new Date(tglStr);
            if (isNaN(date.getTime())) return esc(tglStr);
            return date.toLocaleDateString("id-ID", {
                day: "2-digit",
                month: "long",
                year: "numeric"
            });
        }

        function formatRupiah(num) {
            return "Rp " + parseFloat(num || 0).toLocaleString("id-ID");
        }

        // Hitung jumlah pertemuan latihan dalam 1 bulan berdasarkan jadwal hari ranting/rayon
        function hitungJadwalBulanan(jadwalHariStr, yearMonthStr) {
            if (!jadwalHariStr || !yearMonthStr) return { total: 0, hariLabels: [] };
            const lower = String(jadwalHariStr).toLowerCase();
            const hariMap = [
                { idx: 0, label: "Minggu", keys: ["minggu", "ahad"] },
                { idx: 1, label: "Senin", keys: ["senin"] },
                { idx: 2, label: "Selasa", keys: ["selasa"] },
                { idx: 3, label: "Rabu", keys: ["rabu"] },
                { idx: 4, label: "Kamis", keys: ["kamis"] },
                { idx: 5, label: "Jumat", keys: ["jumat", "jum'at"] },
                { idx: 6, label: "Sabtu", keys: ["sabtu"] }
            ];

            const scheduledDayIndices = new Set();
            const hariLabels = [];
            hariMap.forEach(h => {
                if (h.keys.some(k => lower.includes(k))) {
                    scheduledDayIndices.add(h.idx);
                    hariLabels.push(h.label);
                }
            });

            if (scheduledDayIndices.size === 0) {
                return { total: 0, hariLabels: [] };
            }

            const [yearStr, monthStr] = yearMonthStr.split("-");
            const year = parseInt(yearStr, 10);
            const month = parseInt(monthStr, 10);
            if (isNaN(year) || isNaN(month)) return { total: 0, hariLabels };

            const daysInMonth = new Date(year, month, 0).getDate();
            let total = 0;
            for (let day = 1; day <= daysInMonth; day++) {
                const dayOfWeek = new Date(year, month - 1, day).getDay();
                if (scheduledDayIndices.has(dayOfWeek)) {
                    total++;
                }
            }
            return { total, hariLabels };
        }

        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("fa-eye-slash", "fa-eye");
            }
