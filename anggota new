        // Render Absensi Pribadi Anggota & Persentase Bulanan
        function renderAbsensiPribadi() {
            if (!anggotaAktif) return;

            const bulanInput = document.getElementById("filter-absensi-bulan");
            const bulanDipilih = (bulanInput && bulanInput.value) ? bulanInput.value : currentMonthISO();
            const filterStatus = document.getElementById("filter-absensi-status").value;

            const namaAnggotaNorm = (anggotaAktif.nama_lengkap || "").trim().toLowerCase();
            const rayonAnggota = (anggotaAktif.ranting_rayon || "").trim();
            const detailRayon = dataRayon.find(r => cocokNamaRayon(r.nama_rayon_ranting, rayonAnggota));

            document.getElementById("absensi-subinfo").innerText =
                `${anggotaAktif.nama_lengkap || "-"} • ${detailRayon ? detailRayon.nama_rayon_ranting : (rayonAnggota || "-")}`;

            const absenPribadiSemua = dataAbsensi.filter(item => {
                if (item.peserta_id !== undefined && item.peserta_id !== null && String(item.peserta_id) !== "") {
                    return String(item.peserta_id) === String(anggotaAktif.id);
                }
                const namaCocok = (item.nama_lengkap || "").trim().toLowerCase() === namaAnggotaNorm;
                const rayonCocok = !item.ranting_rayon || !rayonAnggota || cocokNamaRayon(item.ranting_rayon, rayonAnggota);
                return namaCocok && rayonCocok;
            });

            const absenBulanIni = absenPribadiSemua.filter(item => (item.tanggal || "").startsWith(bulanDipilih));

            const jmlHadir = absenBulanIni.filter(a => (a.status || "").toLowerCase() === "hadir").length;
            const jmlIzin = absenBulanIni.filter(a => (a.status || "").toLowerCase() === "izin").length;
            const jmlSakit = absenBulanIni.filter(a => (a.status || "").toLowerCase() === "sakit").length;
            const jmlAlpha = absenBulanIni.filter(a => (a.status || "").toLowerCase() === "alpha").length;

            const infoJadwal = hitungJadwalBulanan(detailRayon ? detailRayon.jadwal_hari : "", bulanDipilih);
            const totalJadwalBulanan = infoJadwal.total;

            const tanggalHadirUnik = new Set(
                absenBulanIni
                    .filter(a => (a.status || "").toLowerCase() === "hadir" && a.tanggal)
                    .map(a => a.tanggal)
            ).size;

            const pembagi = totalJadwalBulanan > 0 ? totalJadwalBulanan : absenBulanIni.length;
            const persentase = pembagi > 0
                ? Math.min(100, Math.round(((totalJadwalBulanan > 0 ? tanggalHadirUnik : jmlHadir) / pembagi) * 100))
                : 0;

            const namaBulanLabel = formatBulanTahun(bulanDipilih);
            document.getElementById("absen-label-bulan").innerText = namaBulanLabel;
            document.getElementById("absen-persentase").innerText = `${persentase}%`;
            document.getElementById("absen-progress-bar").style.width = `${persentase}%`;

            if (totalJadwalBulanan > 0) {
                document.getElementById("absen-jadwal-bulanan").innerText = `${totalJadwalBulanan} Pertemuan`;
                document.getElementById("absen-hari-rayon").innerText = `Jadwal: ${detailRayon.jadwal_hari}`;
                document.getElementById("absen-formula-info").innerText =
                    `${tanggalHadirUnik} kali Hadir dari ${totalJadwalBulanan} jadwal latihan (${infoJadwal.hariLabels.join(", ")}) pada ${namaBulanLabel}`;
            } else {
                document.getElementById("absen-jadwal-bulanan").innerText = `Belum Diatur`;
                document.getElementById("absen-hari-rayon").innerText = detailRayon && detailRayon.jadwal_hari
                    ? `Jadwal: ${detailRayon.jadwal_hari}`
                    : "Jadwal hari latihan rayon belum tersedia";
                document.getElementById("absen-formula-info").innerText =
                    `${jmlHadir} kali Hadir dari ${absenBulanIni.length} catatan absensi pada ${namaBulanLabel}`;
            }

            document.getElementById("absen-jml-hadir").innerText = jmlHadir;
            document.getElementById("absen-jml-izin").innerText = jmlIzin;
            document.getElementById("absen-jml-sakit").innerText = jmlSakit;
            document.getElementById("absen-jml-alpha").innerText = jmlAlpha;

            const filteredRows = absenBulanIni.filter(item => !filterStatus || item.status === filterStatus);
            const tbody = document.getElementById("tbody-absensi");

            if (filteredRows.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="border border-slate-300 text-center py-8 text-slate-400">
                            Belum ada data absensi Anda pada bulan ${esc(namaBulanLabel)}.
                        </td>
                    </tr>
                `;
                return;
            }

            const badgeMap = {
                Hadir: "bg-emerald-100 text-emerald-700 border-emerald-200",
                Izin: "bg-blue-100 text-blue-700 border-blue-200",
                Sakit: "bg-amber-100 text-amber-700 border-amber-200",
                Alpha: "bg-rose-100 text-rose-700 border-rose-200"
            };

            tbody.innerHTML = filteredRows.map((item, idx) => {
                const status = item.status || "-";
                const badgeClass = badgeMap[status] || "bg-slate-100 text-slate-700 border-slate-200";
                const ketHtml = item.keterangan
                    ? `<span class="block sm:inline sm:ml-2 text-[11px] text-slate-500">(${esc(item.keterangan)})</span>`
                    : "";

                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="border border-slate-300 px-4 py-3 text-center font-semibold text-slate-600">${idx + 1}</td>
                        <td class="border border-slate-300 px-4 py-3 whitespace-nowrap font-medium text-slate-800">${formatTanggal(item.tanggal)}</td>
                        <td class="border border-slate-300 px-4 py-3">
                            <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${badgeClass}">${esc(status)}</span>
                            ${ketHtml}
                        </td>
                    </tr>
                `;
            }).join("");
        }

        // ==================== RIWAYAT PEMBAYARAN PRIBADI ANGGOTA ====================
        function getRiwayatPembayaranPribadi() {
            if (!anggotaAktif) return [];

            const namaAnggotaNorm = (anggotaAktif.nama_lengkap || "").trim().toLowerCase();
            const rayonAnggota = (anggotaAktif.ranting_rayon || "").trim();

            return dataKasAnggota.filter(item => {
                if (item.anggota_id !== undefined && item.anggota_id !== null && String(item.anggota_id) !== "") {
                    return String(item.anggota_id) === String(anggotaAktif.id);
                }
                const namaCocok = (item.nama_anggota || "").trim().toLowerCase() === namaAnggotaNorm;
                const rayonCocok = !item.ranting_rayon || !rayonAnggota || cocokNamaRayon(item.ranting_rayon, rayonAnggota);
                return namaCocok && rayonCocok;
            });
        }

        function getFilteredRiwayatPembayaran() {
            const bulanDipilih = document.getElementById("filter-riwayat-bulan")?.value || "";
            const statusDipilih = document.getElementById("filter-riwayat-status")?.value || "";

            return getRiwayatPembayaranPribadi().filter(item => {
                const st = item.status || "Dikonfirmasi";
                const matchBulan = !bulanDipilih || String(item.tanggal || "").startsWith(bulanDipilih);
                const matchStatus = !statusDipilih || st === statusDipilih;
                return matchBulan && matchStatus;
            });
        }

        function renderRiwayatPembayaran() {
            if (!anggotaAktif) return;

            const semuaPribadi = getRiwayatPembayaranPribadi();
            const filtered = getFilteredRiwayatPembayaran();

            document.getElementById("riwayat-subinfo").innerText =
                `${anggotaAktif.nama_lengkap || "-"} • ${anggotaAktif.ranting_rayon || "-"}`;

            const listOk = filtered.filter(i => (i.status || "Dikonfirmasi") === "Dikonfirmasi");
            const listPending = filtered.filter(i => i.status === "Menunggu");
            const listNo = filtered.filter(i => i.status === "Ditolak");

            const totalKasPribadi = listOk.reduce((sum, i) => sum + Math.max(0, parseFloat(i.nominal || 0)), 0);

            document.getElementById("riwayat-total-pribadi").innerText = formatRupiah(totalKasPribadi);
            document.getElementById("riwayat-total-info").innerText =
                `${listOk.length} pembayaran terkonfirmasi dari ${semuaPribadi.length} total catatan`;
            document.getElementById("riwayat-count-ok").innerText = listOk.length;
            document.getElementById("riwayat-count-pending").innerText = listPending.length;
            document.getElementById("riwayat-count-no").innerText = listNo.length;

            const tbody = document.getElementById("tbody-riwayat");
            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="border border-slate-300 text-center py-8 text-slate-400">
                            Belum ada riwayat pembayaran kas anggota pribadi.
                        </td>
                    </tr>
                `;
                return;
