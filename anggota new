        // State Sidebar (Desktop default terbuka, Mobile default tertutup)
        let lastIsDesktop = window.innerWidth >= 1024;
        let sidebarTerbuka = lastIsDesktop;

        function setSidebar(buka) {
            sidebarTerbuka = buka;
            terapkanStateSidebar();
        }

        function toggleSidebar() {
            sidebarTerbuka = !sidebarTerbuka;
            terapkanStateSidebar();
