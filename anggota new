            }).join("");
        }

        // Kontrol Tampilan Banner Jadwal Latihan Hari Ini (Hanya untuk Menu Jadwal Latihan)
        function updateBannerJadwalHariIni() {
            const banner = document.getElementById("banner-jadwal-hari-ini");
            if (!banner) return;

            if (tabAktif !== "jadwal") {
                banner.classList.add("hidden");
                return;
            }

            const hariList = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
            const hariIni = hariList[new Date().getDay()];
            const jadwalHariIni = dataRayon.filter(r => (r.jadwal_hari || "").toLowerCase().includes(hariIni.toLowerCase()));

            if (jadwalHariIni.length > 0) {
                banner.classList.remove("hidden");
                banner.innerHTML = `
                    <div class="flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-bell text-amber-600"></i>
                        <h3 class="text-xs font-bold text-amber-800 uppercase tracking-wider">Jadwal Latihan Hari Ini (${hariIni})</h3>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                        ${jadwalHariIni.map(r => `
                            <div class="bg-white/80 px-3 py-2 rounded-xl border border-amber-200/70 flex items-center justify-between text-xs">
                                <span class="font-bold text-slate-800 truncate mr-2">${esc(r.nama_rayon_ranting)}</span>
                                <span class="text-amber-700 font-semibold whitespace-nowrap"><i class="fa-regular fa-clock mr-1"></i>${esc(r.jam_latihan || "-")}</span>
                            </div>
                        `).join("")}
                    </div>
                `;
            } else {
                banner.classList.add("hidden");
            }
        }

        // Render Jadwal Latihan
        function renderJadwalLatihan() {
            const container = document.getElementById("list-jadwal");
            const kueri = (document.getElementById("cari-jadwal").value || "").toLowerCase();

            const hariList = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
            const hariIni = hariList[new Date().getDay()];

            updateBannerJadwalHariIni();

            const filtered = dataRayon.filter(item => {
                const teks = `${item.nama_rayon_ranting || ""} ${item.kategori_rr || ""} ${item.lokasi_latihan || ""} ${item.jadwal_hari || ""} ${item.pelatih_tetap || ""}`.toLowerCase();
                return teks.includes(kueri);
            });

            const rayonAnggota = anggotaAktif ? (anggotaAktif.ranting_rayon || "") : "";
            filtered.sort((a, b) => {
                const aMatch = cocokNamaRayon(a.nama_rayon_ranting, rayonAnggota) ? 1 : 0;
                const bMatch = cocokNamaRayon(b.nama_rayon_ranting, rayonAnggota) ? 1 : 0;
                return bMatch - aMatch;
            });

            document.getElementById("count-jadwal").innerText = `${filtered.length} Lokasi`;

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-xs text-slate-400">Tidak ada jadwal latihan ditemukan.</div>`;
                return;
            }

            container.innerHTML = filtered.map(item => {
                const isMilikAnggota = rayonAnggota && cocokNamaRayon(item.nama_rayon_ranting, rayonAnggota);
                const isHariIni = (item.jadwal_hari || "").toLowerCase().includes(hariIni.toLowerCase());
                return `
                    <div class="p-3.5 rounded-xl border ${isMilikAnggota ? "border-emerald-300 bg-emerald-50/40" : "border-slate-200/80 bg-slate-50/70"} transition-all">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="text-sm font-bold text-slate-800">${esc(item.nama_rayon_ranting || "-")}</h3>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-100 text-purple-700">${esc(item.kategori_rr || "Rayon")}</span>
                                ${isMilikAnggota ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-600 text-white">Rayon Anda</span>` : ""}
                                ${isHariIni ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500 text-white">Latihan Hari Ini</span>` : ""}
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-[11px] text-slate-600 mt-2">
                            <div><i class="fa-regular fa-calendar-check text-purple-500 mr-1.5"></i><b>Hari:</b> ${esc(item.jadwal_hari || "-")}</div>
                            <div><i class="fa-regular fa-clock text-purple-500 mr-1.5"></i><b>Jam:</b> ${esc(item.jam_latihan || "-")}</div>
                            <div><i class="fa-solid fa-location-dot text-rose-500 mr-1.5"></i><b>Tempat:</b> ${esc(item.lokasi_latihan || "-")}</div>
                            <div><i class="fa-solid fa-user-shield text-blue-500 mr-1.5"></i><b>Pelatih:</b> ${esc(item.pelatih_tetap || "Belum Ditunjuk")}</div>
                        </div>
                    </div>
                `;
            }).join("");
        }

        // Render Laporan Kas
        function renderLaporanKas() {
            let totalMasuk = 0;
            let totalKeluar = 0;
            dataKeuangan.forEach(k => {
                const nom = parseFloat(k.nominal || 0);
                if (k.tipe === "pemasukan") totalMasuk += nom;
                else totalKeluar += nom;
            });
            const saldo = totalMasuk - totalKeluar;

            document.getElementById("kas-saldo").innerText = formatRupiah(saldo);
            document.getElementById("kas-masuk").innerText = "+ " + formatRupiah(totalMasuk);
            document.getElementById("kas-keluar").innerText = "- " + formatRupiah(totalKeluar);

            const filterTipe = document.getElementById("filter-kas-tipe").value;
            const kueri = (document.getElementById("cari-kas").value || "").toLowerCase();

            const filtered = dataKeuangan.filter(item => {
                const cocokTipe = !filterTipe || item.tipe === filterTipe;
                const cocokCari = (item.keterangan || "").toLowerCase().includes(kueri) || (item.tanggal || "").includes(kueri);
                return cocokTipe && cocokCari;
            });

            const tbody = document.getElementById("tbody-kas");
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-8 text-slate-400">Tidak ada transaksi kas ditemukan.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map((item, idx) => {
                const isMasuk = item.tipe === "pemasukan";
                const badgeTipe = isMasuk
                    ? `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 uppercase">Pemasukan</span>`
                    : `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 uppercase">Pengeluaran</span>`;
                const nominalText = isMasuk
                    ? `<span class="font-bold text-emerald-600 whitespace-nowrap">+ ${formatRupiah(item.nominal)}</span>`
                    : `<span class="font-bold text-rose-600 whitespace-nowrap">- ${formatRupiah(item.nominal)}</span>`;

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-4 py-3 text-slate-500 font-medium">${idx + 1}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-slate-700">${formatTanggal(item.tanggal)}</td>
                        <td class="px-4 py-3">${badgeTipe}</td>
                        <td class="px-4 py-3">${nominalText}</td>
                        <td class="px-4 py-3 text-slate-700 min-w-[180px]">${esc(item.keterangan || "-")}</td>
                        <td class="px-4 py-3 text-center">${renderTombolBerkas(item.foto, item.keterangan || "Bukti Transaksi")}</td>
                    </tr>
                `;
            }).join("");
        }

        // Render Administrasi Surat
        function renderAdministrasiSurat() {
            const countMasuk = dataSurat.filter(s => s.jenis_surat === "Surat Masuk").length;
            const countKeluar = dataSurat.filter(s => s.jenis_surat === "Surat Keluar").length;
            document.getElementById("surat-masuk-count").innerText = countMasuk;
            document.getElementById("surat-keluar-count").innerText = countKeluar;

            const filterJenis = document.getElementById("filter-surat-jenis").value;
            const kueri = (document.getElementById("cari-surat").value || "").toLowerCase();

            const filtered = dataSurat.filter(item => {
                const cocokJenis = !filterJenis || item.jenis_surat === filterJenis;
                const teks = `${item.nomor_surat || ""} ${item.perihal || ""} ${item.sub_kategori || ""}`.toLowerCase();
                return cocokJenis && teks.includes(kueri);
            });

            const tbody = document.getElementById("tbody-surat");
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-400">Tidak ada data surat ditemukan.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map((item, idx) => {
                const isMasuk = item.jenis_surat === "Surat Masuk";
                const badgeSurat = isMasuk
                    ? `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700 whitespace-nowrap">Surat Masuk</span>`
                    : `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700 whitespace-nowrap">Surat Keluar</span>`;

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-4 py-3 text-slate-500 font-medium">${idx + 1}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-slate-700">${formatTanggal(item.tanggal_surat)}</td>
                        <td class="px-4 py-3">${badgeSurat}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-slate-600">${esc(item.sub_kategori || "-")}</td>
                        <td class="px-4 py-3 whitespace-nowrap font-semibold text-slate-800">${esc(item.nomor_surat || "-")}</td>
                        <td class="px-4 py-3 text-slate-700 min-w-[200px]">${esc(item.perihal || "-")}</td>
                        <td class="px-4 py-3 text-center">${renderTombolBerkas(item.foto, item.perihal || "Berkas Surat")}</td>
                    </tr>
                `;
            }).join("");
        }

        // Helper Render Berkas (Gambar / PDF / Excel)
        function renderTombolBerkas(fileData, judul) {
            if (!fileData) return `<span class="text-slate-300">-</span>`;
            const safeTitle = esc(judul);
            if (fileData.includes("application/pdf")) {
                return `<button type="button" onclick='bukaFileData(${safeJsonAttr(fileData)}, "berkas.pdf")' class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 text-[11px] font-bold cursor-pointer"><i class="fa-solid fa-file-pdf"></i> PDF</button>`;
            } else if (fileData.includes("spreadsheet") || fileData.includes("excel") || fileData.includes("text/csv")) {
                return `<button type="button" onclick='bukaFileData(${safeJsonAttr(fileData)}, "dokumen.xlsx")' class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-600 hover:bg-emerald-100 text-[11px] font-bold cursor-pointer"><i class="fa-solid fa-file-excel"></i> File</button>`;
            } else {
                return `<img src="${esc(fileData)}" alt="${safeTitle}" onclick='bukaPreviewFoto(${safeJsonAttr(fileData)}, ${safeJsonAttr(judul)})' class="w-9 h-9 rounded-lg object-cover border border-slate-200 cursor-pointer hover:scale-110 transition-transform mx-auto">`;
            }
        }

        // Buka PDF / Dokumen Base64 via Blob agar aman di semua browser
        function bukaFileData(dataUri, filename) {
            try {
                if (!dataUri.startsWith("data:")) {
                    window.open(dataUri, "_blank");
                    return;
                }
                const parts = dataUri.split(",");
                const mimeMatch = parts[0].match(/:(.*?);/);
                const mime = mimeMatch ? mimeMatch[1] : "application/octet-stream";
                const bstr = atob(parts[1]);
                let n = bstr.length;
                const u8arr = new Uint8Array(n);
                while (n--) {
                    u8arr[n] = bstr.charCodeAt(n);
                }
                const blob = new Blob([u8arr], { type: mime });
                const blobUrl = URL.createObjectURL(blob);
                const win = window.open(blobUrl, "_blank");
                if (!win) {
                    const a = document.createElement("a");
                    a.href = blobUrl;
                    a.download = filename;
                    a.click();
                }
            } catch (e) {
                alert("Tidak dapat membuka berkas.");
            }
        }

        function bukaPreviewFoto(src, caption) {
            document.getElementById("preview-img").src = src;
            document.getElementById("preview-caption").innerText = caption || "";
            document.getElementById("modal-preview").classList.remove("hidden");
        }

        function tutupPreviewFoto() {
            document.getElementById("modal-preview").classList.add("hidden");
        }

        // Navigasi Menu Sidebar
        function pilihTab(tab) {
            tabAktif = tab;

            const judulMap = {
                dashboard: "Dashboard Anggota",
                biodata: "Biodata Pribadi Anggota",
                absensi: "Absensi Pribadi Anggota",
                riwayat: "Riwayat Pembayaran Pribadi",
                agenda: "Data Agenda Kegiatan",
                jadwal: "Jadwal Latihan Rayon & Ranting",
                kas: "Laporan Kas Organisasi",
                surat: "Administrasi Surat"
            };
            document.getElementById("topbar-title").innerText = judulMap[tab] || "Portal Anggota";

            document.querySelectorAll(".sidebar-btn").forEach(btn => {
                if (btn.dataset.tab === tab) {
                    btn.classList.add("sidebar-link-active");
                    btn.classList.remove("text-slate-300", "hover:bg-slate-800");
                } else {
                    btn.classList.remove("sidebar-link-active");
                    btn.classList.add("text-slate-300", "hover:bg-slate-800");
                }
            });

            const secDashboard = document.getElementById("sec-dashboard");
            const secBiodata = document.getElementById("sec-biodata");
            const secAbsensi = document.getElementById("sec-absensi");
            const secRiwayat = document.getElementById("sec-riwayat");
            const secAgenda = document.getElementById("sec-agenda");
            const secJadwal = document.getElementById("sec-jadwal");
            const secKas = document.getElementById("sec-kas");
            const secSurat = document.getElementById("sec-surat");

            [secDashboard, secBiodata, secAbsensi, secRiwayat, secAgenda, secJadwal, secKas, secSurat].forEach(el => el.classList.add("hidden"));

            if (tab === "dashboard") {
                secDashboard.classList.remove("hidden");
                renderDashboard();
            } else if (tab === "biodata") {
                secBiodata.classList.remove("hidden");
            } else if (tab === "absensi") {
                secAbsensi.classList.remove("hidden");
                renderAbsensiPribadi();
            } else if (tab === "riwayat") {
                secRiwayat.classList.remove("hidden");
                renderRiwayatPembayaran();
            } else if (tab === "agenda") {
                secAgenda.classList.remove("hidden");
            } else if (tab === "jadwal") {
                secJadwal.classList.remove("hidden");
            } else if (tab === "kas") {
                secKas.classList.remove("hidden");
            } else if (tab === "surat") {
                secSurat.classList.remove("hidden");
            }

            updateBannerJadwalHariIni();

            if (window.innerWidth < 1024) {
                setSidebar(false);
            }
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        // Cek sesi login otomatis saat halaman di-refresh & muat dropdown rayon pendaftaran
        window.addEventListener("DOMContentLoaded", async () => {
            muatDropdownRayonPendaftaran();

            const savedId = sessionStorage.getItem("anggota_id_login");
            if (savedId) {
                try {
                    const snap = await database.ref("administrasi_digital/anggota/" + savedId).once("value");
                    const val = snap.val();
                    const st = String(val?.status || "Dikonfirmasi").toLowerCase();
                    if (snap.exists() && st !== "menunggu" && st !== "ditolak") {
                        anggotaAktif = { ...val, id: val.id || savedId };
                        bukaPortalAnggota();
                    } else {
                        sessionStorage.removeItem("anggota_id_login");
                    }
                } catch (e) {
                    sessionStorage.removeItem("anggota_id_login");
                }
            }
        });
    </script>
